/**
 * 8-way Or gate: 
 * out = in[0] Or in[1] Or ... Or in[7]
 */
CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    // this is a reduction of Or's
    Or(a=in[0], b=in[1], out=x0);
    Or(a=x0, b=in[2], out=x1);
    Or(a=x1, b=in[3], out=x2);
    Or(a=x2, b=in[4], out=x3);
    Or(a=x3, b=in[5], out=x4);
    Or(a=x4, b=in[6], out=x5);
    Or(a=x5, b=in[7], out=out);

}